<!--
  The harness-gates Maven profile. Paste into the <profiles> block of the StoreOps pom.xml.

  This is the single definition of every automated gate. The Generator runs it before writing its
  summary, the Evaluator runs it to decide gates BUILD-1 / ERR-1 / TEST-1 and all ArchUnit rules,
  and CI activates the same profile unchanged.

  That last property is the point. Thresholds are defined here and nowhere else: if coverage moves,
  it moves in this file and both the harness and the pipeline read it from here. A harness that
  enforces different numbers from CI is worse than no harness, because a PASS stops meaning
  anything and the divergence is invisible until someone merges.

      ./mvnw -q clean verify -Pharness-gates
-->
<profile>
    <id>harness-gates</id>

    <properties>
        <archunit.version>1.3.0</archunit.version>
        <checkstyle.plugin.version>3.5.0</checkstyle.plugin.version>
        <spotbugs.plugin.version>4.8.6.4</spotbugs.plugin.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!--
              ERR-1 (primary) and BUILD-2. Fails the build on violation, not on warning.

              Two executions, because the two halves of BUILD-2 live in different source trees.
              A single execution cannot do both: includeTestSourceDirectory=false is required to keep
              the convention checks off the test tree, and that same setting makes a test-source
              @Disabled rule unmatchable.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                </configuration>
                <executions>

                    <!-- main sources: ERR-1, BUILD-2 suppressions, conventions -->
                    <execution>
                        <id>harness-checkstyle-main</id>
                        <phase>validate</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <configLocation>.harness/checks/checkstyle-harness.xml</configLocation>
                            <suppressionsLocation>
                                .harness/checks/checkstyle-suppressions.xml
                            </suppressionsLocation>
                            <includeTestSourceDirectory>false</includeTestSourceDirectory>
                        </configuration>
                    </execution>

                    <!-- test sources: BUILD-2 only. Nothing else, deliberately — see the config. -->
                    <execution>
                        <id>harness-checkstyle-build2-tests</id>
                        <phase>validate</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <configLocation>
                                .harness/checks/checkstyle-build2-tests.xml
                            </configLocation>
                            <sourceDirectories>
                                <sourceDirectory>${project.build.testSourceDirectory}</sourceDirectory>
                            </sourceDirectories>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <!-- BUILD-1. HIGH and MEDIUM findings only; LOW is noise on a stub codebase. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                </configuration>
                <executions>
                    <execution>
                        <id>harness-spotbugs</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              TEST-1. Per-package thresholds matching Section 3.6: service 80%, web 70%,
              shared 60%, overall 70%.

              Note the ordering: the bundle rule runs first so an overall failure is reported
              before a package failure. On a small codebase a single uncovered service class can
              trip both, and the overall number is the one that tells a developer whether the
              problem is local or systemic.

              Each PACKAGE rule lists its include pattern in BOTH dotted and slash form. JaCoCo
              matches a rule's includes against the coverage node's name, and a package node is
              named in VM form (com/cognizant/storeops/activities/service), so a dotted-only
              pattern can match nothing — and a PACKAGE rule that matches nothing PASSES silently.
              That failure mode is the one this harness exists to prevent: a gate that reads as
              covered and never fires. Includes are OR-ed, so listing both forms costs nothing and
              the rule binds whichever form the JaCoCo version in use reports.

              Verify once, after the first real sprint, that the per-package rules actually bind:

                  # drop one service class's tests, then
                  ./mvnw -q clean verify -Pharness-gates
                  # expect: "com.cognizant.storeops.<module>.service ... but expected minimum is 0.80"
                  # if only the BUNDLE rule fires, the package patterns are not matching — fix them
                  #   before trusting TEST-1, and record it in .harness/reviews/debt-log.md
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>harness-coverage-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.cognizant.storeops.*.service*</include>
                                        <include>com/cognizant/storeops/*/service*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.cognizant.storeops.*.web*</include>
                                        <include>com/cognizant/storeops/*/web*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.cognizant.storeops.shared*</include>
                                        <include>com/cognizant/storeops/shared*</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              ARCH-1..4 and the ERR-1 backstop. ArchitectureRulesTest is never excluded and never
              skipped, because skipping tests defeats every architectural gate in the harness.

              Both switches are pinned, and they are not the same switch. An explicit plugin
              <configuration> value overrides the matching -D user property, so:

                <skipTests>false</skipTests>  neutralises -DskipTests
                <skip>false</skip>            neutralises -Dmaven.test.skip

              Without the second one, -Dmaven.test.skip=true skips test *compilation* and the build
              goes green with nine ArchUnit rules and the JaCoCo check never having run. That is the
              one command line that turns a PASS into theatre.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                </configuration>
            </plugin>

        </plugins>
    </build>
</profile>
